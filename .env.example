# Copia este archivo a ".env" y rellena el valor. El archivo ".env" NO se sube a git.
#
# Clave para firmar los tokens JWT en el perfil "prod" (Docker). Debe ser una cadena en base64
# de al menos 64 bytes. Para generar una en PowerShell:
#   $b = New-Object byte[] 64; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# O con OpenSSL (Git Bash / Linux / macOS):
#   openssl rand -base64 64 | tr -d '
'
JHIPSTER_JWT_SECRET=
